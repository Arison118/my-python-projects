<!DOCTYPE html>
<html lang="mg">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>AI Chatbot Arison</title>
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        }

        body {
            background-color: #0b0d14;
            color: #e3e3e3;
            display: flex;
            flex-direction: column;
            height: 100vh;
            overflow: hidden;
        }

        /* HEADER */
        header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 12px 16px;
            background-color: #0b0d14;
            height: 55px;
        }

        .header-left {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .menu-icon {
            width: 22px;
            height: 22px;
            fill: #c4c7c5;
        }

        .model-selector {
            font-size: 1.1rem;
            font-weight: 600;
            color: #e3e3e3;
        }

        .new-chat-btn {
            font-size: 1.3rem;
            color: #c4c7c5;
            cursor: pointer;
        }

        /* MAIN CONTAINER */
        .main-container {
            flex: 1;
            display: flex;
            flex-direction: column;
            overflow-y: auto;
            padding: 15px 15px 100px 15px;
        }

        .welcome-screen {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            gap: 12px;
        }

        .gemini-sparkle {
            width: 90px;
            height: 90px;
            border-radius: 50%;
            overflow: hidden;
            border: 3px solid #00f3ff;
            box-shadow: 0 0 20px #00f3ff;
            animation: pulseGlow 2.5s infinite alternate;
        }

        @keyframes pulseGlow {
            0% { box-shadow: 0 0 15px #00f3ff; border-color: #00f3ff; }
            100% { box-shadow: 0 0 30px #ff007f; border-color: #ff007f; }
        }

        .gemini-sparkle img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .welcome-subtitle {
            font-size: 1.05rem;
            color: #d1d5db;
        }

        .neon-title {
            font-size: 2.1rem;
            font-weight: 900;
            letter-spacing: 2px;
            color: #fff;
            animation: neonGlow 2s ease-in-out infinite alternate;
        }

        @keyframes neonGlow {
            0% { text-shadow: 0 0 5px #fff, 0 0 10px #00f3ff, 0 0 20px #00f3ff; }
            100% { text-shadow: 0 0 10px #fff, 0 0 20px #ff007f, 0 0 30px #ff007f; }
        }

        .blue-wishes {
            font-size: 0.95rem;
            color: #00d2ff;
            text-shadow: 0 0 8px rgba(0, 210, 255, 0.6);
            font-weight: 600;
            max-width: 90%;
            line-height: 1.4;
        }

        /* CHAT MESSAGES */
        .chat-box {
            display: flex;
            flex-direction: column;
            gap: 18px;
            width: 100%;
        }

        .message {
            font-size: 1rem;
            line-height: 1.5;
            word-wrap: break-word;
        }

        .user-message {
            align-self: flex-end;
            background-color: #282a2c;
            color: #e3e3e3;
            padding: 10px 16px;
            border-radius: 20px;
            max-width: 85%;
        }

        .ai-message {
            align-self: flex-start;
            color: #e3e3e3;
            width: 100%;
        }

        /* INPUT BAR AMBANY */
        .input-wrapper {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            padding: 10px 14px 16px 14px;
            background-color: #0b0d14;
            z-index: 100;
        }

        .input-bar {
            display: flex;
            align-items: center;
            background-color: #1e1f20;
            border-radius: 28px;
            padding: 6px 10px 6px 14px;
            width: 100%;
            gap: 8px;
            box-shadow: 0 2px 12px rgba(0,0,0,0.5);
            border: 1px solid #333537;
        }

        .action-btn {
            background: none;
            border: none;
            color: #c4c7c5;
            font-size: 1.3rem;
            cursor: pointer;
            width: 32px;
            height: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        input[type="text"] {
            flex: 1;
            background: none;
            border: none;
            color: #e3e3e3;
            font-size: 0.98rem;
            outline: none;
            height: 38px;
        }

        /* BOKOTRA MANAMBARA ALEFA (SEND BUTTON) */
        .send-btn {
            background-color: #00f3ff;
            color: #000;
            font-weight: bold;
            font-size: 1rem;
            border: none;
            border-radius: 50%;
            width: 36px;
            height: 36px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            box-shadow: 0 0 8px #00f3ff;
        }

        #fileInput { display: none; }
    </style>
</head>
<body>

    <header>
        <div class="header-left">
            <svg class="menu-icon" viewBox="0 0 24 24"><path d="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z"/></svg>
            <div class="model-selector">Arison AI ✦</div>
        </div>
        <div class="new-chat-btn" onclick="location.reload()">✎</div>
    </header>

    <div class="main-container" id="mainContainer">
        <div class="welcome-screen" id="welcomeScreen">
            <div class="gemini-sparkle">
                <img src="arison.jpg" alt="Arison">
            </div>
            <p class="welcome-subtitle">Tongasoa eto amin'ny pejiny</p>
            <h1 class="neon-title">AI ARISON</h1>
            <p class="blue-wishes">✨ Mazoto hatrany amin'izay ataonao ato tompoko dia mirary fahombiazana. 🚀</p>
        </div>

        <div class="chat-box" id="chatBox" style="display: none;"></div>
    </div>

    <div class="input-wrapper">
        <div class="input-bar">
            <button class="action-btn" onclick="document.getElementById('fileInput').click()">＋</button>
            <input type="file" id="fileInput">

            <input type="text" id="userInput" placeholder="Demander à Arison..." onkeydown="if(event.key === 'Enter') sendMessage()">

            <button class="action-btn" id="micBtn" onclick="startVoice()">🎙️</button>
            <!-- BOKOTRA ALEFA HITA AKARI-MASO -->
            <button class="send-btn" onclick="sendMessage()">➔</button>
        </div>
    </div>
<script>
const API_KEY = "AQ.Ab8RN6JTdS1AJdZyRQTPiXbMkyGRpnid_rwBgZ4vcAodtKmM4w";

function startVoice() {
    const micBtn = document.getElementById("micBtn");
    const userInput = document.getElementById("userInput");
    const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;

    if (SpeechRecognition) {
        const recognition = new SpeechRecognition();
        recognition.lang = 'fr-FR';
        recognition.start();
        micBtn.style.color = "#00f3ff";

        recognition.onresult = function(event) {
            userInput.value = event.results[0][0].transcript;
            micBtn.style.color = "#c4c7c5";
        };
        recognition.onerror = function() { micBtn.style.color = "#c4c7c5"; };
        recognition.onend = function() { micBtn.style.color = "#c4c7c5"; };
    } else {
        alert("Ampiasao amin'ny Chrome ny microphone.");
    }
}

async function sendMessage() {
    const inputField = document.getElementById("userInput");
    const chatBox = document.getElementById("chatBox");
    const welcomeScreen = document.getElementById("welcomeScreen");
    const mainContainer = document.getElementById("mainContainer");
    const message = inputField.value.trim();

    if (message === "") return;

    // Afatoy ny Welcome screen
    if (welcomeScreen) {
        welcomeScreen.style.display = "none";
        chatBox.style.display = "flex";
    }

    // Mampiseho ny hafatry ny User
    const userDiv = document.createElement("div");
    userDiv.className = "message user-message";
    userDiv.textContent = message;
    chatBox.appendChild(userDiv);

    inputField.value = "";

    // Mampiseho fa am-pamoahana ny AI
    const loadingDiv = document.createElement("div");
    loadingDiv.className = "message ai-message";
    loadingDiv.innerHTML = `<span style="color:#7cacf8;">⏳ AI Arison manomana valiny...</span>`;
    chatBox.appendChild(loadingDiv);
    mainContainer.scrollTop = mainContainer.scrollHeight;

    try {
        const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=${API_KEY}`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
                contents: [{ parts: [{ text: message }] }]
            })
        });

        const data = await response.json();

        if (data.error) {
            loadingDiv.innerHTML = `<span style="color:#ff6b6b;">❌ Erreur: ${data.error.message}</span>`;
        } else {
            const rawText = data.candidates[0].content.parts[0].text;
            loadingDiv.innerHTML = marked.parse(rawText);
        }
    } catch (error) {
        loadingDiv.innerHTML = `<span style="color:#ff6b6b;">❌ Problème de connexion. Checkeo ny internet na API Key.</span>`;
    }

    mainContainer.scrollTop = mainContainer.scrollHeight;
}
</script>
</body>
</html>

